# ----------------------------------------------------
# 1. 成果物と生成物（Gitの追跡から除外すべきファイル）
# ----------------------------------------------------
# 実行結果として生成される全てのファイル形式を無視
*.xlsx
*.csv
*.png
*.jpg
*.log

# Jupyter Notebookのチェックポイントフォルダを無視
.ipynb_checkpoints/

# 成果物フォルダ全体を無視 (このフォルダ内のファイルは全て追跡しない)
output/
result/


# ----------------------------------------------------
# 2. 環境ファイルと一時ファイル
# ----------------------------------------------------
# Pythonのキャッシュフォルダ
__pycache__/


# ----------------------------------------------------
# 3. 例外（追跡対象に戻すファイル）
# ----------------------------------------------------
# data/ フォルダ内のCSVファイルを例外的に追跡対象に戻す
# ここに置かれているCSVファイルは「元データ」であり、共有すべきと仮定
# !data/*.csv
# !data/**/*.csv